. * the engine's cfprobit mapping on the same data reproduces the closed-form A
> IE
. mata:
------------------------------------------------- mata (type end to exit) -----
: pape_frame_open(rows(x1), 2, 3)

: d = pape_dgp_blank()

: d.k = 1; d.has_m = 1; d.n_inst = 2; d.first_stage = "probit"; d.focal = pape_
> var_new("f", "binary", .4, ., ., .)

: d.moderator = pape_var_new("m", "binary", .5, ., ., .)

: xx = pape_xdraw()

: xx.y = y0i; xx.d = y2b; xx.m = m; xx.Zx = x1; xx.X1 = X1m

: cfs = pape_cf_fit_stata(d, xx, 0, 0, apem = ., sem = .)

: es = pape_cf_aie_est(cfs.theta, cfs.W, "binary", cfs.cf_col, cfs.cfm_col)

: rec("H_aie", "aie (engine stata)", "R cf_aie_est", es.ape, refv("H_aie", "aie
> "), 1e-5)

: rec("H_aie", "se (engine stata)", "R cf_aie_est", sqrt(es.jac' * cfs.V_main *
>  es.jac), refv("H_aie", "se"), 1e-5)

: // 0.1.1: effects(margins) for the IV AIE = margins, dydx(d) at(m = 0 1) afte
> r cfprobit
: // with the factor-form interaction (the control function held fixed: cfprobi
> t's
: // predict(pr) is the ASF). Against the R closed form on the same data.
: cfm = pape_cf_fit_stata(d, xx, 0, 1, apem = ., sem = .)

: rec("H_aie", "aie (margins dydx at)", "R cf_aie_est", apem, refv("H_aie", "ai
> e"), 1e-6)

: rec("H_aie", "se (margins dydx at)", "R cf_aie_est", sem, refv("H_aie", "se")
> , 1e-6)

: // continuous focal (linear first stage) with interact(m): the R-port closed 
> form on
: // the same data is the reference (its APE counterparts are certified above, 
> H_lin);
: // y2, y0 were read from the fixture before the engine's temporary frame was 
> opened
: fl = pape_cf_fit(y0, y2, m, 1, x1, X1m, "linear", J(0, 1, .), J(0, 1, .))

: el = pape_cf_aie_est(fl.theta, fl.W, "normal", fl.cf_col, fl.cfm_col)

: d2 = pape_dgp_blank()

: d2.k = 1; d2.has_m = 1; d2.n_inst = 2; d2.first_stage = "linear"

: d2.focal = pape_var_new("f", "normal", ., 0, 1, .)

: d2.moderator = pape_var_new("m", "binary", .5, ., ., .)

: xx2 = pape_xdraw()

: xx2.y = y0; xx2.d = y2; xx2.m = m; xx2.Zx = x1; xx2.X1 = X1m

: cfs2 = pape_cf_fit_stata(d2, xx2, 0, 0, apem2 = ., sem2 = .)

: es2 = pape_cf_aie_est(cfs2.theta, cfs2.W, "normal", cfs2.cf_col, cfs2.cfm_col
> )

: rec("H_aie_c", "aie (engine stata)", "R port cf_aie_est", es2.ape, el.ape, 1e
> -5)

: rec("H_aie_c", "se (engine stata)", "R port cf_aie_est", sqrt(es2.jac' * cfs2
> .V_main * es2.jac), sqrt(el.jac' * fl.V_main * el.jac), 1e-5)

: cfm2 = pape_cf_fit_stata(d2, xx2, 0, 1, apem2 = ., sem2 = .)

: rec("H_aie_c", "aie (margins dydx at)", "R port cf_aie_est", apem2, el.ape, 1
> e-6)

: rec("H_aie_c", "se (margins dydx at)", "R port cf_aie_est", sem2, sqrt(el.jac
> ' * fl.V_main * el.jac), 1e-6)

: pape_frame_close()

: end
