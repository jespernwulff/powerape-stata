. 
. * ---- A: probit, binary focal, two covariates ------------------------------
> -
. import delimited data/fixA.csv, clear varnames(1)
(encoding automatically selected: ISO-8859-2)
(4 vars, 2,000 obs)

. mata:
------------------------------------------------- mata (type end to exit) -----
: X = (J(st_nobs(), 1, 1), st_data(., ("d", "z1", "z2"))); y = st_data(., "y")

: ft = pape_fit_index(X, y, "probit", J(0, 1, .))

: e = pape_ape_est(ft.b, X, 2, "probit", "binary")

: for (j = 1; j <= 4; j++) rec("A", sprintf("b%f", j), "R fit_index_model", ft.
> b[j], refv("A", sprintf("b%f", j)), 1e-6)

: for (j = 1; j <= 4; j++) rec("A", sprintf("jac%f", j), "R ape_binary_est", e.
> jac[j], refv("A", sprintf("jac%f", j)), 1e-6)

: rec("A", "ape", "R ape_binary_est", e.ape, refv("A", "ape"), 1e-7)

: rec("A", "se_model", "R vcov_from_glmfit", sqrt(e.jac' * ft.V * e.jac), refv(
> "A", "se_model"), 1e-6)

: rec("A", "se_robust", "R vcov_sandwich HC0", sqrt(e.jac' * pape_vcov_sandwich
> (ft, X, y, "probit") * e.jac), refv("A", "se_robust"), 1e-6)

: end
-------------------------------------------------------------------------------

. quietly probit y i.d z1 z2

. quietly margins, dydx(d)

. mata: b = st_matrix("r(b)"); V = st_matrix("r(V)")

. mata: rec("A", "ape", "Stata probit+margins", b[2], refv("A", "ape"), 1e-6)

. mata: rec("A", "se_model", "Stata margins (OIM)", sqrt(V[2, 2]), refv("A", "s
> e_model"), 1e-2)

. mata: Vm_oim = V

. quietly probit y i.d z1 z2, vce(robust)

. quietly margins, dydx(d)

. mata: V = st_matrix("r(V)")

. mata: rec("A", "se_robust", "Stata vce(robust) (OIM)", sqrt(V[2, 2]), refv("A
> ", "se_robust"), 1e-2)

. * the Stata engine's fit function (OIM) versus the direct command
. mata: pape_frame_open(2000, 3, 0)

. mata: fs = pape_fit_stata(X, y, J(0, 1, .), "probit", "oim", 0)

. mata: rec("A", "b2 (engine stata)", "R fit_index_model", fs.b[2], refv("A", "
> b2"), 1e-5)

. mata: es = pape_ape_est(fs.b, X, 2, "probit", "binary")

. mata: rec("A", "ape (engine stata)", "R ape_binary_est", es.ape, refv("A", "a
> pe"), 1e-6)

. mata: rec("A", "se_model (engine stata)", "Stata margins (OIM)", sqrt(es.jac'
>  * fs.V * es.jac), sqrt(Vm_oim[2, 2]), 1e-2)

. mata: pape_frame_close()

