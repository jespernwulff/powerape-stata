> scalar("r(power)"), st_numscalar("r(mcse)"), refd("D3", "power"), 3)

. powerape dgp d2b, model(logit) focal(x, normal) moderator(m, binary p(0.5)) c
> ovariates((z, normal)) baseline(0.35) signal(0.1) nodisplay

. powerape setaie d2b, target(0.03) mainfocal(0.05) mainmoderator(0.08) nodispl
> ay

. powerape power d2b, n(3000) claim(detect) nsim(`NS') seed(210) engine(mata) n
> odisplay

. mata: recd("D3b AIE continuous x binary (logit), engine(mata)", st_numscalar(
> "r(power)"), st_numscalar("r(mcse)"), refd("D3b", "power"), 3)

