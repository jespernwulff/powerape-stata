
. di as txt "powerape `pav'; Stata `c(stata_version)' (`c(born_date)')"
powerape 0.1.3 (Stata port of powerape 1.11.3); Stata 19.5 (14 Oct 2026)

. import delimited data/did-reference.csv, clear varnames(1) stringcols(1 2) as
> double
(encoding automatically selected: ISO-8859-1)
(3 vars, 380 obs)

. mata:
------------------------------------------------- mata (type end to exit) -----
: REFC = st_sdata(., "case"); REFI = st_sdata(., "item"); REFV = st_data(., "va
> lue")

: real scalar refv(string scalar c, string scalar it)
> {
>     external string colvector REFC, REFI
>     external real colvector REFV
>     real scalar j
>     for (j = 1; j <= rows(REFC); j++) if (REFC[j] == c & REFI[j] == it) retur
> n(REFV[j])
>     return(.)
> }

: RES = J(0, 1, ""); NP = 0; NF = 0

: // absolute difference against tol x max(1, |reference|)
: void recc(string scalar cs, string scalar item, real scalar stata, real scala
> r r, real scalar tol, string scalar note)
> {
>     external string colvector RES
>     external real scalar NP, NF
>     real scalar d, ok
>     d = abs(stata - r)
>     ok = (stata != . & r != . & d <= tol * max((1, abs(r))))
>     RES = RES \ sprintf("%-6s %-15s Stata %13.8f  R %13.8f  |diff| %9.2e  tol
>  %7.1e  %s  %s", cs, item, stata, r, d, tol, (ok ? "PASS" : "FAIL"), note)
>     if (ok) NP++
>     else NF++
> }

: end
-------------------------------------------------------------------------------

. 
. * compare everything a design stores; M = number of subgroups (1 or 2);
. * tolc for coefficients, tolr for rates, readings and the true effect
. program define calcheck
  1.     args cs M tolc tolr note
  2.     powerape describe `cs'
  3.     tempname R C
  4.     matrix `R' = r(rates)
  5.     matrix `C' = r(didcoef)
  6.     local rl = r(reading_linear)
  7.     local ri = r(reading_index)
  8.     local sig = r(signal)
  9.     forvalues m = 1/`M' {
 10.         local sfx = cond(`M' == 1, "", "_" + string(`m' - 1))
 11.         local j 0
 12.         foreach nm in a b l th de {
 13.             local ++j
 14.             mata: recc("`cs'", "`nm'`sfx'", st_matrix("`C'")[`m', `j'], re
> fv("`cs'", "`nm'`sfx'"), `tolc', "`note'")
 15.         }
 16.         local j 0
 17.         foreach nm in c00 c01 c10 cf c11 {
 18.             local ++j
 19.             mata: recc("`cs'", "`nm'`sfx'", st_matrix("`R'")[`m', `j'], re
> fv("`cs'", "`nm'`sfx'"), `tolr', "`note'")
 20.         }
 21.     }
 22.     mata: recc("`cs'", "reading_linear", `rl', refv("`cs'", "reading_linea
> r"), `tolr', "`note'")
 23.     mata: recc("`cs'", "reading_index", `ri', refv("`cs'", "reading_index"
> ), `tolr', "`note'")
 24.     mata: recc("`cs'", "signal_implied", `sig', refv("`cs'", "signal_impli
> ed"), `tolr', "`note'")
 25.     powerape trueatt `cs'
 26.     mata: recc("`cs'", "true effect", st_numscalar("r(att)"), refv("`cs'",
>  "true"), `tolr', "`note'")
 27.     mata: bt = pape_did_beta(pape_get_dgp("`cs'"))
 28.     mata: for (j = 1; j <= rows(bt); j++) recc("`cs'", sprintf("beta%f", j
> ), bt[j], refv("`cs'", sprintf("beta%f", j)), `tolc', "`note'")
 29.     mata: recc("`cs'", "length of beta", rows(bt), sum(REFC :== "`cs'" :& 
> substr(REFI, 1, 4) :== "beta"), 0, "`note'")
 30. end

. 
. * closed forms (no covariates)
. powerape dgp c1, did model(logit) baseline(0.20) gap(0.20) trend(0.10) rho(0.
> 4) nodisplay

. powerape setatt c1, target(0.07) nodisplay

. calcheck c1 1 1e-8 1e-9 "closed form"
powerape DGP -- logit, difference-in-differences (two periods)
  data: panel, both periods per unit; rho = 0.40 (latent within-unit correlatio
> n); unit-clustered SEs
  analysis: pooled logit; ATT = average partial effect of the treatment indicat
> or over treated post-period rows
  treated group: 50% of units
  covariates: none
  untreated trends: parallel on the logit index (the scale the logit analysis a
> ssumes)
  rates before -> after: control 0.200 -> 0.300; treated 0.400 -> 0.603 (0.533 
> without treatment)
  true ATT pinned at +0.0700 (treatment coefficient = 0.2858)
  the same four rates read under linear-parallel trends: +0.1033 (their cross d
> ifference)
true ATT of DGP c1 on the integration set:          .07

