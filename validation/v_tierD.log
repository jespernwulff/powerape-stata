. * D10: alpha rule and robustness sweep
. powerape power d0, n(712) claim(detect) alpharule(0.05*sqrt(500/@n)) nsim(`NS
> ') seed(227) engine(mata) nodisplay

. mata: recd("D10 power under the alpha rule", st_numscalar("r(power)"), st_num
> scalar("r(mcse)"), refd("D10", "power_rule"), 3)

. mata: recr("D10 alpha from the rule at n 712", st_numscalar("r(alpha)"), refd
> ("D10", "alpha_rule")[1], 1e-9)

. powerape robust d1, n(700) claim(detect) vary(baseline(0.20 0.40)) nsim(2000)
>  seed(228) nonmax engine(mata) nodisplay

. mata: S = st_matrix("r(scenarios)")

. forvalues i = 1/3 {
  2.     mata: recd("D10 robust scenario `i' power (baseline sweep)", S[`i', 3]
> , S[`i', 4], refd("D10", "robust_power_`i'"), 3)
  3. }

. 
. * D11: justified alpha
. powerape power d1, n(2000) claim(minimum) sesoi(0.02) nsim(`NS') seed(229) en
> gine(mata) nodisplay

