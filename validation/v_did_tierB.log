
. di as txt "powerape `pav'; Stata `c(stata_version)' (`c(born_date)')"
powerape 0.1.3 (Stata port of powerape 1.11.3); Stata 19.5 (14 Oct 2026)

. 
. import delimited data/did-reference.csv, clear varnames(1) stringcols(1 2) as
> double
(encoding automatically selected: ISO-8859-1)
(3 vars, 380 obs)

. mata:
------------------------------------------------- mata (type end to exit) -----
: REFC = st_sdata(., "case"); REFI = st_sdata(., "item"); REFV = st_data(., "va
> lue")

: real scalar refv(string scalar c, string scalar it)
> {
>     external string colvector REFC, REFI
>     external real colvector REFV
>     real scalar j
>     for (j = 1; j <= rows(REFC); j++) if (REFC[j] == c & REFI[j] == it) retur
> n(REFV[j])
>     return(.)
> }

: RES = J(0, 1, "")

: NP = 0; NF = 0

: void rec(string scalar cs, string scalar item, string scalar against, real sc
> alar stata, real scalar r, real scalar tol)
> {
>     external string colvector RES
>     external real scalar NP, NF
>     real scalar d, ok
>     d = abs(stata - r)
>     ok = (stata != . & r != . & d <= tol * max((1, abs(r))))
>     RES = RES \ sprintf("%-5s %-15s %-34s %14.8f %14.8f %10.2e %8.0e %s", cs,
>  item, against, stata, r, d, tol, (ok ? "PASS" : "FAIL"))
>     if (ok) NP++
>     else NF++
> }

: end
-------------------------------------------------------------------------------

. 
. * One fixture through every path of the port. Arguments: case, link, number
. * of periods, the standard-error kind of the index analysis in cross-sections
. * (model or robust; clustered fixtures ignore it).
. program define tierb
  1.     args cs link T sekind
  2.     import delimited data/didfix_`cs'.csv, clear varnames(1) asdouble
  3.     mata: K = refv("`cs'", "k"); fc = refv("`cs'", "focal_col")
  4.     mata: X = (J(st_nobs(), 1, 1), st_data(., "x" :+ strofreal(2..K))); y 
> = st_data(., "y")
  5.     mata: id = st_data(., "id"); msub = st_data(., "m")
  6.     mata: id = (all(id :== 0) ? J(0, 1, .) : id)
  7.     mata: msub = (refv("`cs'", "by0") == . ? J(0, 1, .) : msub)
  8.     mata: sen = (rows(id) > 0 ? "se_cluster" : "se_`sekind'")
  9.     mata: lsen = (rows(id) > 0 ? "lin_se_cluster" : "lin_se_hc1")
 10.     mata: est = .; se = .; b = .; jac = .; by = .
 11.     mata: rec("`cs'", "sum_y", "the data R wrote", sum(y), refv("`cs'", "s
> um_y"), 0)
 12.     * engine(mata), index analysis: coefficients, estimate, Jacobian, SE
.     mata: ok = pape_did_analyze(X, y, id, msub, "`link'", `T', "index", "`sek
> ind'", "mata", "closed", est, se, b, jac, by)
 13.     mata: for (j = 1; j <= K; j++) rec("`cs'", sprintf("b%f", j), "R fit_i
> ndex_model", b[j], refv("`cs'", sprintf("b%f", j)), 1e-6)
 14.     mata: for (j = 1; j <= K; j++) rec("`cs'", sprintf("jac%f", j), "R att
> _est / datt_est", jac[j], refv("`cs'", sprintf("jac%f", j)), 1e-6)
 15.     mata: rec("`cs'", "est", "R, engine(mata)", est, refv("`cs'", "est"), 
> 1e-7)
 16.     mata: rec("`cs'", sen, "R, engine(mata)", se, refv("`cs'", sen), 1e-6)
 17.     mata: for (j = 1; j <= 2 * (cols(by) == 2); j++) rec("`cs'", sprintf("
> by%f", j - 1), "R datt_est", by[j], refv("`cs'", sprintf("by%f", j - 1)), 1e-
> 7)
 18.     mata: est_m = est; se_m = se
 19.     * engine(stata), effects(closed): Stata's fit, closed-form effect. Sta
> ta's
.     * probit variance uses the observed information and R's the expected, so
.     * probit SEs are compared at 1e-2; logit SEs coincide
.     * (Stata's vce(robust) also carries the factor N/(N-1), which the R sandw
> ich
.     * does not: 1e-3 for those rows)
.     mata: tolse = ("`link'" == "probit" ? 1e-2 : (rows(id) == 0 & "`sekind'" 
> == "robust" ? 1e-3 : 1e-5))
 20.     mata: ok = pape_did_analyze(X, y, id, msub, "`link'", `T', "index", "`
> sekind'", "stata", "closed", est, se, b, jac, by)
 21.     mata: rec("`cs'", "est", "R, engine(stata) closed", est, refv("`cs'", 
> "est"), 1e-5)
 22.     mata: rec("`cs'", sen, "R, engine(stata) closed", se, refv("`cs'", sen
> ), tolse)
 23.     mata: est_c = est; se_c = se
 24.     * engine(stata), effects(margins): margins, dydx() subpop() [over()]
.     mata: ok = pape_did_analyze(X, y, id, msub, "`link'", `T', "index", "`sek
> ind'", "stata", "margins", est, se, b, jac, by)
 25.     mata: rec("`cs'", "est", "R, engine(stata) margins", est, refv("`cs'",
>  "est"), 1e-5)
 26.     mata: rec("`cs'", sen, "R, engine(stata) margins", se, refv("`cs'", se
> n), tolse)
 27.     mata: rec("`cs'", "est", "margins = closed form", est, est_c, 1e-7)
 28.     mata: rec("`cs'", sen, "margins = closed form", se, se_c, 1e-6)
 29.     * linear analysis: OLS in Mata and Stata's regress
.     mata: ok = pape_did_analyze(X, y, id, msub, "`link'", `T', "linear", "mod
> el", "mata", "closed", est, se, b, jac, by)
 30.     mata: rec("`cs'", "lin_b", "R fit_ols, engine(mata)", est, refv("`cs'"
> , "lin_b"), 1e-9)
 31.     mata: rec("`cs'", lsen, "R vcov_ols, engine(mata)", se, refv("`cs'", l
> sen), 1e-9)
 32.     mata: ok = pape_did_analyze(X, y, id, msub, "`link'", `T', "linear", "
> model", "stata", "closed", est, se, b, jac, by)
 33.     mata: rec("`cs'", "lin_b", "R fit_ols, engine(stata) regress", est, re
> fv("`cs'", "lin_b"), 1e-9)
 34.     mata: rec("`cs'", lsen, "R vcov_ols, engine(stata) regress", se, refv(
> "`cs'", lsen), 1e-9)
 35. end

. 
