. * the copula's joint rate, the pilot's method-of-moments solver, and the
. * estimates from a pilot panel that both packages read
. mata: recc("pilot", "joint rate", pape_did_joint_rate(0.30, 0.30, 0.5), refv(
> "pilot", "joint_30_05"), 1e-9, "bivariate normal")

. mata: recc("pilot", "joint rate", pape_did_joint_rate(0.08, 0.08, 0.2), refv(
> "pilot", "joint_08_02"), 1e-9, "bivariate normal")

. mata: recc("pilot", "rho solver", pape_did_pilot_rho((0.25 \ 0.35), (0.11 \ 0
> .19), (800 \ 760)), refv("pilot", "rho_solve"), 1e-7, "method of moments")

. import delimited data/didfix_pilot.csv, clear varnames(1) asdouble
(encoding automatically selected: ISO-8859-1)
(4 vars, 9,000 obs)

. powerape dgp dp, didpilot outcome(y) group(g) id(id) period(period) trend(0.0
> 5) model(logit) nodisplay

. matrix PL = r(pilot)

. matrix RT = r(rates)

. mata: PL = st_matrix("PL")

. mata: recc("pilot", "baseline", PL[5], refv("pilot", "baseline"), 1e-12, "sam
> e pilot file")

. mata: recc("pilot", "gap", PL[6], refv("pilot", "gap"), 1e-12, "same pilot fi
> le")

. mata: recc("pilot", "p_treated", PL[7], refv("pilot", "p_treated"), 1e-12, "s
> ame pilot file")

. mata: recc("pilot", "rho", PL[8], refv("pilot", "rho"), 1e-7, "same pilot fil
> e")

. mata: recc("pilot", "control_change", PL[9], refv("pilot", "control_change"),
>  1e-12, "same pilot file")

. mata: recc("pilot", "n_pairs", PL[4], refv("pilot", "n_pairs"), 0, "same pilo
> t file")

. mata: recc("pilot", "cf", st_matrix("RT")[1, 4], refv("pilot", "cf"), 1e-9, "
> same pilot file")

. clear

