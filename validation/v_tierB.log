. import delimited data/reference.csv, clear varnames(1) stringcols(1 2) asdoub
> le
(encoding automatically selected: ISO-8859-1)
(3 vars, 151 obs)

. mata:
------------------------------------------------- mata (type end to exit) -----
: REFC = st_sdata(., "case"); REFI = st_sdata(., "item"); REFV = st_data(., "va
> lue")

: real scalar refv(string scalar c, string scalar it)
> {
>     external string colvector REFC, REFI
>     external real colvector REFV
>     real scalar j
>     for (j = 1; j <= rows(REFC); j++) if (REFC[j] == c & REFI[j] == it) retur
> n(REFV[j])
>     return(.)
> }

: RES = J(0, 1, "")

: RESN = J(0, 5, .)

: void rec(string scalar cs, string scalar item, string scalar against, real sc
> alar stata, real scalar r, real scalar tol)
> {
>     external string colvector RES
>     external real matrix RESN
>     real scalar d, rel
>     d = abs(stata - r)
>     rel = (r != 0 ? d / abs(r) : d)
>     RES = RES \ sprintf("%-8s %-14s %-24s %14.8f %14.8f %10.2e %8.0e %s", cs,
>  item, against, stata, r, d, tol, (d <= tol * max((1, abs(r))) ? "PASS" : "FA
> IL"))
>     RESN = RESN \ (stata, r, d, tol, d <= tol * max((1, abs(r))))
> }
note: variable rel set but not used.

: end
