. * ---- H: control-function probit -------------------------------------------
> ---
. import delimited data/fixH.csv, clear varnames(1)
(encoding automatically selected: ISO-8859-1)
(10 vars, 1,500 obs)

. mata:
------------------------------------------------- mata (type end to exit) -----
: x1 = st_data(., "x1"); z1 = st_data(., "z1"); z2 = st_data(., "z2"); cid = st
> _data(., "cid")

: y2 = st_data(., "y2"); y0 = st_data(., "y0"); y2b = st_data(., "y2b"); y0b = 
> st_data(., "y0b")

: m = st_data(., "m"); y0i = st_data(., "y0i")

: X1 = (J(rows(x1), 1, 1), x1, z1, z2)

: f = pape_cf_fit(y0, y2, J(0, 1, .), 0, x1, X1, "linear", J(0, 1, .), J(0, 1, 
> .))

: e = pape_cf_ape_est(f.theta, f.W, "normal", f.cf_col, ., 0)

: for (j = 1; j <= 4; j++) rec("H_lin", sprintf("theta%f", j), "R cf_fit", f.th
> eta[j], refv("H_lin", sprintf("theta%f", j)), 1e-6)

: for (j = 1; j <= 4; j++) rec("H_lin", sprintf("se_theta%f", j), "R cf_fit sta
> cked vcov", sqrt(f.V_main[j, j]), refv("H_lin", sprintf("se_theta%f", j)), 1e
> -6)

: rec("H_lin", "ape", "R cf_ape_est", e.ape, refv("H_lin", "ape"), 1e-7)

: rec("H_lin", "se", "R cf_ape_est", sqrt(e.jac' * f.V_main * e.jac), refv("H_l
> in", "se"), 1e-6)

: fc = pape_cf_fit(y0, y2, J(0, 1, .), 0, x1, X1, "linear", cid, J(0, 1, .))

: ec = pape_cf_ape_est(fc.theta, fc.W, "normal", fc.cf_col, ., 0)

: rec("H_lin_cl", "se", "R cf_fit cluster", sqrt(ec.jac' * fc.V_main * ec.jac),
>  refv("H_lin_cl", "se"), 1e-6)

: fb = pape_cf_fit(y0b, y2b, J(0, 1, .), 0, x1, X1, "probit", J(0, 1, .), J(0, 
> 1, .))

: eb = pape_cf_ape_est(fb.theta, fb.W, "binary", fb.cf_col, ., 0)

: for (j = 1; j <= 4; j++) rec("H_prb", sprintf("theta%f", j), "R cf_fit", fb.t
> heta[j], refv("H_prb", sprintf("theta%f", j)), 1e-6)

: for (j = 1; j <= 4; j++) rec("H_prb", sprintf("se_theta%f", j), "R cf_fit sta
> cked vcov", sqrt(fb.V_main[j, j]), refv("H_prb", sprintf("se_theta%f", j)), 1
> e-6)

: rec("H_prb", "ape", "R cf_ape_est", eb.ape, refv("H_prb", "ape"), 1e-7)

: rec("H_prb", "se", "R cf_ape_est", sqrt(eb.jac' * fb.V_main * eb.jac), refv("
> H_prb", "se"), 1e-6)

: X1m = (J(rows(x1), 1, 1), x1, m, z1, z2, z1 :* m, z2 :* m)

: fi = pape_cf_fit(y0i, y2b, m, 1, x1, X1m, "probit", J(0, 1, .), J(0, 1, .))

: ei = pape_cf_aie_est(fi.theta, fi.W, "binary", fi.cf_col, fi.cfm_col)

: for (j = 1; j <= 7; j++) rec("H_aie", sprintf("theta%f", j), "R cf_fit", fi.t
> heta[j], refv("H_aie", sprintf("theta%f", j)), 1e-6)

: for (j = 1; j <= 7; j++) rec("H_aie", sprintf("se_theta%f", j), "R cf_fit sta
> cked vcov", sqrt(fi.V_main[j, j]), refv("H_aie", sprintf("se_theta%f", j)), 1
> e-6)

: rec("H_aie", "aie", "R cf_aie_est", ei.ape, refv("H_aie", "aie"), 1e-7)

: rec("H_aie", "se", "R cf_aie_est", sqrt(ei.jac' * fi.V_main * ei.jac), refv("
> H_aie", "se"), 1e-6)

: end
