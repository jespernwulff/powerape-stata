. mata: recd("D3 AIE binary x binary, engine(stata)", st_numscalar("r(power)"),
>  st_numscalar("r(mcse)"), refd("D3", "power"), 3)

. powerape power d2, n(4000) claim(detect) nsim(300) seed(209) engine(stata) ef
> fects(margins) nodisplay

