. * ---- C-F: AIE, four type pairs --------------------------------------------
. foreach c in C D E F {
  2.     import delimited data/fix`c'.csv, clear varnames(1)
  3.     local link = cond("`c'" == "E", "logit", "probit")
  4.     local ft = cond(inlist("`c'", "C", "E"), "binary", "normal")
  5.     local mt = cond(inlist("`c'", "C", "D"), "binary", "normal")
  6.     mata: X = (J(st_nobs(), 1, 1), st_data(., ("d", "m")), st_data(., "d")
>  :* st_data(., "m"), st_data(., "z")); y = st_data(., "y")
  7.     mata: ft = pape_fit_index(X, y, "`link'", J(0, 1, .))
  8.     mata: e = pape_aie_est(ft.b, X, "`link'", "`ft'", "`mt'")
  9.     mata: for (j = 1; j <= 5; j++) rec("`c'", sprintf("b%f", j), "R fit_in
> dex_model", ft.b[j], refv("`c'", sprintf("b%f", j)), 1e-6)
 10.     mata: for (j = 1; j <= 5; j++) rec("`c'", sprintf("jac%f", j), "R aie_
> est", e.jac[j], refv("`c'", sprintf("jac%f", j)), 1e-6)
 11.     mata: rec("`c'", "aie", "R aie_est", e.ape, refv("`c'", "aie"), 1e-7)
 12.     mata: rec("`c'", "se_model", "R vcov_from_glmfit", sqrt(e.jac' * ft.V 
> * e.jac), refv("`c'", "se_model"), 1e-6)
 13.     local dterm = cond("`ft'" == "binary", "i.d", "c.d")
 14.     local mterm = cond("`mt'" == "binary", "i.m", "c.m")
 15.     quietly `link' y `dterm'##`mterm' z
 16.     quietly ginteff, dydxs(d m)
 17.     mata: b = st_matrix("r(b)"); V = st_matrix("r(V)")
 18.     mata: rec("`c'", "aie", "Stata ginteff", b[1, 1], refv("`c'", "aie"), 
> 1e-6)
 19.     local tolse = cond("`link'" == "logit", "1e-5", "1e-2")
 20.     mata: rec("`c'", "se_model", "Stata ginteff (`=cond("`link'"=="logit",
> "OIM=EIM","OIM")')", sqrt(V[1, 1]), refv("`c'", "se_model"), `tolse')
 21. }
