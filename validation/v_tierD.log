
. di as txt "powerape `pav'; Stata `c(stata_version)' (`c(born_date)')"
powerape 0.1.3 (Stata port of powerape 1.11.3); Stata 19.5 (14 Oct 2026)

. import delimited data/tierD-reference.csv, clear varnames(1) stringcols(1 2) 
> asdouble
(encoding automatically selected: ISO-8859-1)
(4 vars, 40 obs)

. capture destring value mcse, replace force

. mata:
------------------------------------------------- mata (type end to exit) -----
: RD = st_sdata(., "design"); RQ = st_sdata(., "quantity"); RV = st_data(., "va
> lue"); RM = st_data(., "mcse")

: real rowvector refd(string scalar d, string scalar q)
> {
>     external string colvector RD, RQ
>     external real colvector RV, RM
>     real scalar j
>     for (j = 1; j <= rows(RD); j++) if (RD[j] == d & RQ[j] == q) return((RV[j
> ], RM[j]))
>     return((., .))
> }

: RES = J(0, 1, ""); NP = 0; NF = 0

: void recd(string scalar label, real scalar s, real scalar s_mcse, real rowvec
> tor r, real scalar k)
> {
>     external string colvector RES
>     external real scalar NP, NF
>     real scalar tol, ok, rm
>     rm = (r[2] == . ? 0 : r[2])
>     tol = k * sqrt(rm^2 + (s_mcse == . ? 0 : s_mcse)^2)
>     ok = (abs(s - r[1]) <= tol)
>     RES = RES \ sprintf("%-58s Stata %8.4f (MCSE %6.4f)  R %8.4f (MCSE %6.4f)
>   |diff| %6.4f  tol %6.4f  %s", label, s, s_mcse, r[1], rm, abs(s - r[1]), to
> l, (ok ? "PASS" : "FAIL"))
>     if (ok) NP++
>     else NF++
> }

: void recr(string scalar label, real scalar s, real scalar r, real scalar relt
> ol)
> {
>     external string colvector RES
>     external real scalar NP, NF
>     real scalar ok
>     ok = (abs(s - r) <= reltol * max((abs(r), 1e-8)))
>     RES = RES \ sprintf("%-58s Stata %8.4f  R %8.4f  rel.diff %8.2e  tol %6.1
> e  %s", label, s, r, abs(s - r) / max((abs(r), 1e-8)), reltol, (ok ? "PASS" :
>  "FAIL"))
>     if (ok) NP++
>     else NF++
> }

: end
-------------------------------------------------------------------------------

. local NS 4000

. local NSS 1000

. 
. * D1: Design A world
. powerape dgp d1, focal(treat, binary p(0.5)) covariates((age, normal mean(45)
>  sd(12))) baseline(0.30) signal(0.15) nodisplay

. powerape setape d1, target(0.05) nodisplay

. powerape power d1, n(2000) claim(minimum) sesoi(0.02) nsim(`NS') seed(201) en
> gine(mata) nodisplay

. mata: recd("D1 minimum power, n 2000, engine(mata)", st_numscalar("r(power)")
> , st_numscalar("r(mcse)"), refd("D1", "power"), 3)

. mata: o = st_matrix("r(outcomes)")

. mata: recd("D1 detect-only share", o[2], sqrt(o[2] * (1 - o[2]) / `NS'), (ref
> d("D1", "detect_only")[1], sqrt(refd("D1", "detect_only")[1] * (1 - refd("D1"
> , "detect_only")[1]) / 4000)), 3)

. mata: recd("D1 inconclusive share", o[3], sqrt(o[3] * (1 - o[3]) / `NS'), (re
> fd("D1", "inconclusive")[1], sqrt(refd("D1", "inconclusive")[1] * (1 - refd("
> D1", "inconclusive")[1]) / 4000)), 3)

. powerape power d1, n(2000) claim(minimum) sesoi(0.02) nsim(`NSS') seed(202) e
> ngine(stata) nodisplay

. mata: recd("D1 minimum power, engine(stata) probit, nsim 1000", st_numscalar(
> "r(power)"), st_numscalar("r(mcse)"), refd("D1", "power"), 3)

. powerape power d1, n(2000) claim(detect) nsim(`NS') seed(203) engine(mata) no
> display

. mata: recd("D1 detect power, engine(mata)", st_numscalar("r(power)"), st_nums
> calar("r(mcse)"), refd("D1", "power_detect"), 3)

. 
. * D2: logit, continuous focal, robust and model SEs
. powerape dgp d3, model(logit) focal(dose, normal mean(2) sd(1)) covariates((z
> 1, normal) (z2, binary p(0.4))) ///
>     correlation(0.2) baseline(0.25) signal(0.10) nodisplay

. powerape setape d3, target(0.03) nodisplay

. powerape power d3, n(800) claim(detect) nsim(`NS') seed(204) se(robust) engin
> e(mata) nodisplay

. mata: recd("D2 logit continuous, robust SE, engine(mata)", st_numscalar("r(po
> wer)"), st_numscalar("r(mcse)"), refd("D2", "power"), 3)

. powerape power d3, n(800) claim(detect) nsim(`NS') seed(205) engine(mata) nod
> isplay

. mata: recd("D2 logit continuous, model SE, engine(mata)", st_numscalar("r(pow
> er)"), st_numscalar("r(mcse)"), refd("D2", "power_model"), 3)

. powerape power d3, n(800) claim(detect) nsim(`NSS') seed(206) se(robust) engi
> ne(stata) nodisplay

. mata: recd("D2 logit continuous, vce(robust), engine(stata)", st_numscalar("r
> (power)"), st_numscalar("r(mcse)"), refd("D2", "power"), 3)

. 
