. * D8: required n (answers differ by search noise; each must satisfy the confi
> rmation rule,
. *     and the two answers must lie within 6% of each other)
. powerape n d1, power(0.8) claim(detect) nsim(1500) seed(221) engine(mata) nod
> isplay

. mata: recr("D8 required n, detect 80%, Design A world (R 2494)", st_numscalar
> ("r(n)"), refd("D8", "n_detect80")[1], 0.06)

. mata: st_local("okc", strofreal(st_numscalar("r(power)") >= 0.8 - max((0.005,
>  1.5 * st_numscalar("r(mcse)")))))

. mata: recr("D8 confirmation rule satisfied (1 = yes)", `okc', 1, 0)

. powerape n d1, power(0.8) claim(minimum) sesoi(0.02) nsim(1500) seed(222) eng
> ine(mata) nodisplay

. mata: recr("D8 required n, minimum 80% (R 5451)", st_numscalar("r(n)"), refd(
> "D8", "n_minimum80")[1], 0.06)

. powerape dgp d0, focal(t, binary p(0.5)) baseline(0.30) nodisplay

. powerape setape d0, target(0.10) nodisplay

. powerape n d0, power(0.8) claim(detect) nsim(1500) seed(223) engine(mata) nod
> isplay

