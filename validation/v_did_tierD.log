
. di as txt "powerape `pav'; Stata `c(stata_version)' (`c(born_date)')"
powerape 0.2.2 (Stata port of powerape 1.12.2); Stata 19.5 (14 Oct 2026)

. import delimited data/did-tierD-reference.csv, clear varnames(1) stringcols(1
>  2) asdouble
(encoding automatically selected: ISO-8859-1)
(4 vars, 62 obs)

. capture destring value mcse, replace force

. mata:
------------------------------------------------- mata (type end to exit) -----
: RD = st_sdata(., "design"); RQ = st_sdata(., "quantity"); RV = st_data(., "va
> lue"); RM = st_data(., "mcse")

: real rowvector refd(string scalar d, string scalar q)
> {
>     external string colvector RD, RQ
>     external real colvector RV, RM
>     real scalar j
>     for (j = 1; j <= rows(RD); j++) if (RD[j] == d & RQ[j] == q) return((RV[j
> ], RM[j]))
>     return((., .))
> }

: RES = J(0, 1, ""); NP = 0; NF = 0

: void recd(string scalar label, real scalar s, real scalar s_mcse, real rowvec
> tor r, real scalar k)
> {
>     external string colvector RES
>     external real scalar NP, NF
>     real scalar tol, ok, rm
>     rm = (r[2] == . ? 0 : r[2])
>     tol = k * sqrt(rm^2 + (s_mcse == . ? 0 : s_mcse)^2)
>     ok = (s != . & r[1] != . & abs(s - r[1]) <= tol)
>     RES = RES \ sprintf("%-62s Stata %8.4f (MCSE %6.4f)  R %8.4f (MCSE %6.4f)
>   |diff| %6.4f  tol %6.4f  %s", label, s, s_mcse, r[1], rm, abs(s - r[1]), to
> l, (ok ? "PASS" : "FAIL"))
>     if (ok) NP++
>     else NF++
> }

: void recr(string scalar label, real scalar s, real scalar r, real scalar relt
> ol)
> {
>     external string colvector RES
>     external real scalar NP, NF
>     real scalar ok
>     ok = (s != . & r != . & abs(s - r) <= reltol * max((abs(r), 1e-8)))
>     RES = RES \ sprintf("%-62s Stata %9.4f  R %9.4f  rel.diff %8.2e  tol %6.1
> e  %s", label, s, r, abs(s - r) / max((abs(r), 1e-8)), reltol, (ok ? "PASS" :
>  "FAIL"))
>     if (ok) NP++
>     else NF++
> }

: // a share against R's, each with its binomial Monte Carlo error at nsim
: void recs(string scalar label, real scalar s, real scalar r, real scalar nsim
> )
> {
>     recd(label, s, sqrt(s * (1 - s) / nsim), (r, sqrt(r * (1 - r) / 4000)), 3
> )
> }

: end
-------------------------------------------------------------------------------

. local NS 4000

. local NSS 1000

. 
. * P1: logit panel, index world and analysis
. powerape dgp p1, did model(logit) baseline(0.25) gap(0.10) trend(0.08) rho(0.
> 4) nodisplay

. powerape setatt p1, target(0.07) nodisplay

. powerape power p1, n(1500) claim(detect) nsim(`NS') seed(401) engine(mata) no
> display

. mata: recd("P1 logit panel, detect, n 1500, engine(mata)", st_numscalar("r(po
> wer)"), st_numscalar("r(mcse)"), refd("P1", "detect"), 3)

. mata: recd("P1 mean of the estimates", st_numscalar("r(est_mean)"), st_numsca
> lar("r(est_mcse)"), refd("P1", "detect_estmean"), 3)

. powerape power p1, n(1500) claim(minimum) sesoi(0.02) nsim(`NS') seed(402) en
> gine(mata) nodisplay

. mata: recd("P1 minimum (sesoi .02), engine(mata)", st_numscalar("r(power)"), 
> st_numscalar("r(mcse)"), refd("P1", "minimum"), 3)

. mata: o = st_matrix("r(outcomes)")

. mata: recs("P1 detect-only share", o[2], refd("P1", "detect_only")[1], `NS')

. mata: recs("P1 inconclusive share", o[3], refd("P1", "inconclusive")[1], `NS'
> )

. powerape power p1, n(1500) claim(detect) nsim(`NSS') seed(403) engine(stata) 
> nodisplay

. mata: recd("P1 detect, engine(stata) logit vce(cluster), nsim 1000", st_numsc
> alar("r(power)"), st_numscalar("r(mcse)"), refd("P1", "detect"), 3)

