. 
. * ---- Stata's own commands on the fixtures with named variables ------------
> -
. * did: panel, 400 units, one period before and after, covariate z
. import delimited data/didfix_did.csv, clear varnames(1) asdouble
(encoding automatically selected: ISO-8859-2)
(12 vars, 800 obs)

. quietly logit y i.d i.period i.w z, vce(cluster id)

. quietly margins, dydx(w) subpop(if w == 1)

. mata: b = st_matrix("r(b)"); V = st_matrix("r(V)")

. mata: rec("did", "est", "logit + margins subpop()", b[cols(b)], refv("did", "
> est"), 1e-5)

. mata: rec("did", "se_cluster", "logit + margins subpop()", sqrt(V[cols(b), co
> ls(b)]), refv("did", "se_cluster"), 1e-5)

. quietly regress y i.d i.period i.w z, vce(cluster id)

. scalar sb = _b[1.w]

. mata: rec("did", "lin_b", "regress, vce(cluster)", st_numscalar("sb"), refv("
> did", "lin_b"), 1e-9)

. scalar sse = _se[1.w]

. mata: rec("did", "lin_se_cluster", "regress, vce(cluster)", st_numscalar("sse
> "), refv("did", "lin_se_cluster"), 1e-9)

. xtset id period

Panel variable: id (strongly balanced)
 Time variable: period, 1 to 2
         Delta: 1 unit

. quietly xtdidregress (y z) (w), group(id) time(period)

. mata: b = st_matrix("e(b)"); V = st_matrix("e(V)"); N = refv("did", "n")

. mata: rec("did", "lin_b", "xtdidregress", b[1], refv("did", "lin_b"), 1e-9)

. * xtdidregress counts the within regressors (period, w, constant), the pooled
. * regression all five columns: its SE differs by that degrees-of-freedom fact
> or
. mata: rec("did", "lin_se_cluster", "xtdidregress x sqrt((N-3)/(N-5))", sqrt(V
> [1, 1]) * sqrt((N - 3) / (N - 5)), refv("did", "lin_se_cluster"), 1e-9)

. 
. * didx: repeated cross-sections, four periods, treatment from period 3
. import delimited data/didfix_didx.csv, clear varnames(1) asdouble
(encoding automatically selected: ISO-8859-2)
(12 vars, 1,200 obs)

. quietly logit y i.d i.period i.w

. quietly margins, dydx(w) subpop(if w == 1)

. mata: b = st_matrix("r(b)"); V = st_matrix("r(V)")

. mata: rec("didx", "est", "logit + margins subpop()", b[cols(b)], refv("didx",
>  "est"), 1e-5)

. mata: rec("didx", "se_model", "logit + margins subpop()", sqrt(V[cols(b), col
> s(b)]), refv("didx", "se_model"), 1e-5)

. quietly logit y i.d i.period i.w, vce(robust)

. quietly margins, dydx(w) subpop(if w == 1)

. mata: b = st_matrix("r(b)"); V = st_matrix("r(V)")

. * Stata's vce(robust) carries the factor N/(N-1) on the variance; the R
. * sandwich (HC0) does not
. mata: N = refv("didx", "n")

. mata: rec("didx", "se_robust", "logit vce(robust) x sqrt((N-1)/N)", sqrt(V[co
> ls(b), cols(b)]) * sqrt((N - 1) / N), refv("didx", "se_robust"), 1e-5)

. quietly regress y i.d i.period i.w, vce(robust)

. scalar sb = _b[1.w]

. mata: rec("didx", "lin_b", "regress, vce(robust)", st_numscalar("sb"), refv("
> didx", "lin_b"), 1e-9)

. scalar sse = _se[1.w]

. mata: rec("didx", "lin_se_hc1", "regress, vce(robust)", st_numscalar("sse"), 
> refv("didx", "lin_se_hc1"), 1e-9)

. quietly didregress (y) (w), group(d) time(period) vce(robust)

. mata: b = st_matrix("e(b)"); V = st_matrix("e(V)")

. mata: rec("didx", "lin_b", "didregress, vce(robust)", b[1], refv("didx", "lin
> _b"), 1e-9)

. mata: rec("didx", "lin_se_hc1", "didregress, vce(robust)", sqrt(V[1, 1]), ref
> v("didx", "lin_se_hc1"), 1e-9)

. 
. * sub: panel with a binary subgroup m (one period before and after)
. import delimited data/didfix_sub.csv, clear varnames(1) asdouble
(encoding automatically selected: ISO-8859-2)
(14 vars, 1,200 obs)

. generate double md = m * d

. generate double mpost = m * post

. generate double mw = m * w

. quietly logit y i.w##i.m d post md mpost, vce(cluster id)

. quietly margins, dydx(w) subpop(if w == 1) over(m) post

. matrix bb = e(b)

. local nm : colfullnames bb

. local k = colsof(bb)

. local k0 = `k' - 1

. local n0 : word `k0' of `nm'

. local n1 : word `k' of `nm'

. mata: rec("sub", "by0", "margins over(m)", st_matrix("e(b)")[`k0'], refv("sub
> ", "by0"), 1e-5)

. mata: rec("sub", "by1", "margins over(m)", st_matrix("e(b)")[`k'], refv("sub"
> , "by1"), 1e-5)

. quietly lincom _b[`n1'] - _b[`n0']

. mata: rec("sub", "est", "margins over(m) + lincom", st_numscalar("r(estimate)
> "), refv("sub", "est"), 1e-5)

. mata: rec("sub", "se_cluster", "margins over(m) + lincom", st_numscalar("r(se
> )"), refv("sub", "se_cluster"), 1e-5)

. quietly regress y d post w m md mpost mw, vce(cluster id)

. scalar sb = _b[mw]

. mata: rec("sub", "lin_b", "regress, vce(cluster)", st_numscalar("sb"), refv("
> sub", "lin_b"), 1e-9)

. scalar sse = _se[mw]

. mata: rec("sub", "lin_se_cluster", "regress, vce(cluster)", st_numscalar("sse
> "), refv("sub", "lin_se_cluster"), 1e-9)

. * the official triple difference (exact with two periods)
. quietly didregress (y) (mw), group(d m) time(period)

. mata: b = st_matrix("e(b)")

. mata: rec("sub", "lin_b", "didregress, group(d m) (DDD)", b[1], refv("sub", "
> lin_b"), 1e-9)

. 
